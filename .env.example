OPENAI_API_KEY=sk-your-openai-api-key
# Resend — server-only. Never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_resend_api_key
# Optional verified sender. Defaults to Resend's test address.
# RESEND_FROM_EMAIL=Website Contact <onboarding@resend.dev>
# Inbox for Lulaweb customer support form submissions.
# SUPPORT_EMAIL=nkosi.benedict@gmail.com
# Mock AI responses in development (default: on). Set MOCK_AI=false, or add
# mockai=false to the localhost URL, to use real OpenAI locally.
MOCK_AI=true
# Places API only — Maps JavaScript API is not required for address autocomplete.
# Prefer the server-only key. NEXT_PUBLIC_GOOGLE_PLACES_API_KEY is a fallback.
GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Website deployment agent (Java Spring Boot app)
# Local: http://localhost:8080
# Hostwinds: http://104.168.134.8:8080
DEPLOYMENT_AGENT_URL=http://104.168.134.8:8080
DEPLOYMENT_API_KEY=change-me
# Firebase Auth (client). On Vercel these must be set for Production and
# available at Build — Next.js inlines NEXT_PUBLIC_* at compile time.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
# Optional Google Ads tag for conversion events (AW-XXXXXXXXX).
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# Enable Cloud Firestore and Storage in the Firebase console.
# Publish firestore.rules and storage.rules. User profiles and site records are
# stored at users/{uid}, users/{uid}/sites/{websiteId}, users/{uid}/jobs/{jobId},
# and sites/{websiteId}. Generated HTML/CSS/JS/images are
# stored at sites/{websiteId}/ in the Storage bucket. Optional server override:
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Server-only Firebase Admin credentials for Storage and Firestore.
# Vercel: paste the *contents* of firebase-adminsdk.json (the whole JSON object),
# not a file path. Name the env var FIREBASE_SERVICE_ACCOUNT. Keep newlines;
# minify to one line only if the dashboard rejects the paste.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
# Local only: path to a gitignored JSON file.
# FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-adminsdk.json
# Comma-separated Google account emails allowed to open /admin.
# Example: ADMIN_EMAILS=you@example.com,ops@example.com
# ADMIN_EMAILS=
# Domains.co.za reseller API
# Live: https://api.domains.co.za/api
# Dev: https://lapi-dev.domains.co.za/api
# Defaults to the dev URL in `next dev`, live URL otherwise.
# POST {base}/login → JWT used as Authorization: Bearer
# Local: use the lapi-dev account. Production (Vercel): live URL + live credentials.
# DOMAINS_CO_ZA_API_BASE=https://lapi-dev.domains.co.za/api
DOMAINS_CO_ZA_USERNAME=your-reseller-username
DOMAINS_CO_ZA_PASSWORD=your-reseller-password
# Optional, only if 2FA is enabled on the reseller account
# DOMAINS_CO_ZA_2FA_CODE=123456
# A record target after domain registration
NEXT_PUBLIC_SERVER_IP=104.168.134.8
# Public site URL used for PayFast return/notify URLs, canonical SEO URLs,
# Open Graph tags, sitemap.xml, and robots.txt. Required in production.
# PayFast cannot POST ITN to localhost. In `next dev`, returning from sandbox
# checkout marks a pending subscription paid. Production still waits for
# /api/payfast/notify. To receive live ITN locally, point this at a tunnel.
# NEXT_PUBLIC_APP_URL=https://lulaweb.co.za
# PayFast monthly and annual subscriptions, plus Edit packs (R15 / R35 / R50).
# Passphrase is required for subscriptions.
# Sandbox: https://sandbox.payfast.co.za/eng/process
# Live: https://www.payfast.co.za/eng/process
# Toggle on any environment, including production:
#   PAYFAST_SANDBOX=true  → sandbox checkout (test cards)
#   PAYFAST_SANDBOX=false → live checkout (real charges)
# Unset defaults to sandbox in `next dev`, live otherwise.
PAYFAST_SANDBOX=true
# Live merchant — used when PAYFAST_SANDBOX=false
PAYFAST_MERCHANT_ID=your-live-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
# Sandbox merchant — REQUIRED in production when PAYFAST_SANDBOX=true.
# Must match the Salt Passphrase in the sandbox dashboard (sandbox.payfast.co.za).
# Do not point sandbox.payfast.co.za at live merchant keys — PayFast rejects the signature.
PAYFAST_SANDBOX_MERCHANT_ID=10000100
PAYFAST_SANDBOX_MERCHANT_KEY=your-sandbox-merchant-key
PAYFAST_SANDBOX_PASSPHRASE=your-sandbox-passphrase
# Local-only: mark checkout paid without PayFast. Never enable in production.
# PAYFAST_ALLOW_MOCK=true
# Meta WhatsApp Cloud API (server-only; never prefix with NEXT_PUBLIC_).
# Callback URL: https://<your-domain>/api/webhooks/whatsapp
# Subscribe the app webhook to the "messages" field on your WABA.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate-a-long-random-string
# WHATSAPP_ACCESS_TOKEN=your-system-user-or-temporary-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
# WHATSAPP_APP_SECRET=your-meta-app-secret
# Secure R100 deposit checkout URL the sales bot sends on buying intent.
# WHATSAPP_DEPOSIT_PAYMENT_LINK=https://your-payfast-or-checkout-url
# Optional overrides (defaults: 999 / year, R100 deposit).
# WHATSAPP_SALES_OFFER_PRICE=999
# WHATSAPP_SALES_DEPOSIT_PRICE=100
# Optional registrant contact. If omitted, the default reseller contact template is used.
# DOMAINS_CO_ZA_REGISTRANT_TEMPLATE=
# DOMAINS_CO_ZA_REGISTRANT_NAME=
# DOMAINS_CO_ZA_REGISTRANT_EMAIL=
# DOMAINS_CO_ZA_REGISTRANT_COUNTRY=ZA
# DOMAINS_CO_ZA_REGISTRANT_PROVINCE=
# DOMAINS_CO_ZA_REGISTRANT_PHONE=
# DOMAINS_CO_ZA_REGISTRANT_POSTAL_CODE=
# DOMAINS_CO_ZA_REGISTRANT_ADDRESS=
# DOMAINS_CO_ZA_REGISTRANT_CITY=
