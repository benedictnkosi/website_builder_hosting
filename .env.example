OPENAI_API_KEY=sk-your-openai-api-key
# Resend — server-only. Never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_resend_api_key
# Optional verified sender. Defaults to Resend's test address.
# RESEND_FROM_EMAIL=Website Contact <onboarding@resend.dev>
# Mock AI responses in development (default: on). Set MOCK_AI=false to use real APIs locally.
MOCK_AI=true
# Places API only — Maps JavaScript API is not required for address autocomplete.
# Prefer the server-only key. NEXT_PUBLIC_GOOGLE_PLACES_API_KEY is a fallback.
GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Website deployment agent (Java Spring Boot app)
# Local: http://localhost:8080
# Hostwinds: http://104.168.134.8:8080
DEPLOYMENT_AGENT_URL=http://104.168.134.8:8080
DEPLOYMENT_API_KEY=change-me
# Firebase Auth (client)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
# Enable Cloud Firestore and Storage in the Firebase console.
# Publish firestore.rules and storage.rules. User profiles and site records are
# stored at users/{uid}, users/{uid}/sites/{websiteId}, users/{uid}/jobs/{jobId},
# and sites/{websiteId}. Generated HTML/CSS/JS/images are
# stored at sites/{websiteId}/ in the Storage bucket. Optional server override:
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Server-only Firebase Admin credentials for Storage and Firestore billing.
# Local: path to a gitignored JSON file. Vercel: paste the JSON (or its base64) as an env var.
# FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLn0=
# Domains.co.za reseller API
# POST https://api.domains.co.za/api/login → JWT used as Authorization: Bearer
DOMAINS_CO_ZA_USERNAME=your-reseller-username
DOMAINS_CO_ZA_PASSWORD=your-reseller-password
# Optional, only if 2FA is enabled on the reseller account
# DOMAINS_CO_ZA_2FA_CODE=123456
# A record target after domain registration (skipped on localhost)
NEXT_PUBLIC_SERVER_IP=104.168.134.8
# Public site URL used for PayFast return/notify URLs (required in production)
# NEXT_PUBLIC_APP_URL=https://your-domain.example
# PayFast monthly subscriptions. Passphrase is required for subscriptions.
# Sandbox: https://sandbox.payfast.co.za
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_SANDBOX=true
# Local-only: mark checkout paid without PayFast. Never enable in production.
# PAYFAST_ALLOW_MOCK=true
# Optional registrant contact. If omitted, the default reseller contact template is used.
# DOMAINS_CO_ZA_REGISTRANT_TEMPLATE=
# DOMAINS_CO_ZA_REGISTRANT_NAME=
# DOMAINS_CO_ZA_REGISTRANT_EMAIL=
# DOMAINS_CO_ZA_REGISTRANT_COUNTRY=ZA
# DOMAINS_CO_ZA_REGISTRANT_PROVINCE=
# DOMAINS_CO_ZA_REGISTRANT_PHONE=
# DOMAINS_CO_ZA_REGISTRANT_POSTAL_CODE=
# DOMAINS_CO_ZA_REGISTRANT_ADDRESS=
# DOMAINS_CO_ZA_REGISTRANT_CITY=
